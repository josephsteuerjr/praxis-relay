FROM rust:1.94.1-bookworm
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    libgtk-3-dev libwebkit2gtk-4.1-dev libayatana-appindicator3-dev librsvg2-dev \
    libssl-dev pkg-config patchelf rpm python3 python3-gi xvfb xdotool openbox \
    dbus-x11 libglib2.0-bin imagemagick fonts-dejavu-core ca-certificates \
    desktop-file-utils x11-utils && rm -rf /var/lib/apt/lists/*
ENV CARGO_BUILD_JOBS=2
WORKDIR /source
